# =============================================================================
# Avaken Finance OS — environment variables
# =============================================================================
# Copy this file for local development:
#   cp .env.example .env.local
#
# On Vercel: Project → Settings → Environment Variables (never commit real values).
# =============================================================================

# -----------------------------------------------------------------------------
# Database (optional for UI-only dev; required for persisted imports)
# -----------------------------------------------------------------------------
# Postgres connection string (Supabase, Neon, Railway, etc.).
# Use the pooled connection string on serverless (Vercel) when your host offers one.
# Example: postgresql://user:pass@host:5432/db?sslmode=require
#
# When unset, the dashboard and imports use in-memory mock data (great for local UI).
DATABASE_URL=

# -----------------------------------------------------------------------------
# Hermes Agent (your VPS) — screenshot vision extraction
# -----------------------------------------------------------------------------
# Base URL of your Hermes server, e.g. http://YOUR_VPS_IP:8000
# You may also set the full path ending in /api/analyze_screenshots
#
# Must be reachable from Vercel in production (public IP/hostname + firewall rules).
# When unset, screenshot upload uses demo extraction locally.
HERMES_AGENT_URL=

# Shared secret sent to Hermes as Authorization: Bearer <key>
HERMES_AGENT_API_KEY=

# Hermes chat endpoint on your VPS (auto-resolved as <HERMES_AGENT_URL>/api/chat).
# Implement POST /api/chat { "message": "..." } → { "reply": "..." } on the agent.

# -----------------------------------------------------------------------------
# Hermes notifications (cron → Finance OS POST /api/hermes/notify)
# -----------------------------------------------------------------------------
# Your VPS cron jobs can push status updates into the dashboard Hermes feed:
#
#   curl -X POST https://your-app.vercel.app/api/hermes/notify \
#     -H "Authorization: Bearer $IMPORT_JSON_API_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"title":"Morning sync","body":"Imported 12 transactions","severity":"success","job":"morning-sync"}'
#
# severity: info | success | warning | error

# -----------------------------------------------------------------------------
# Inbound JSON import (Hermes VPS → Finance OS POST /api/import/json)
# -----------------------------------------------------------------------------
# API key for server-to-server calls. Send as:
#   Authorization: Bearer <key>   or   x-api-key: <key>
#
# Prefer a dedicated key here. If empty, falls back to HERMES_AGENT_API_KEY.
#
# Production: required (unauthenticated imports are blocked outside development).
IMPORT_JSON_API_KEY=

# -----------------------------------------------------------------------------
# App access (password gate — required in production)
# -----------------------------------------------------------------------------
# When set, the dashboard and API routes require login at /login.
# Leave empty in local dev for open access.
APP_PASSWORD=
STRIPE_SECRET_KEY=
ETORO_API_KEY=
OPENAI_API_KEY=
